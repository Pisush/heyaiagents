# HeyAI platform — environment template. Copy to .env and fill in.
# Never commit the real .env (it is gitignored).

# Signs and verifies proof-of-fetch tokens (HMAC-SHA256). REQUIRED.
# Generate one with: openssl rand -hex 32
SERVER_SECRET=

# Port the single web server listens on (website + MCP).
PORT=8080

# Path to the leaderboard JSON file (the only durable state).
LEADERBOARD_PATH=./leaderboard.json

# Event window: a token's issued_at must fall within this range to count.
EVENT_START=2026-06-17T00:00:00Z
EVENT_END=2026-06-18T23:59:59Z
