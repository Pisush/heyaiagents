# HeyAI Agents — environment template. Copy to .env and fill in.
# Never commit the real .env (it is gitignored).

# --- Backend (Go) ---
# Anthropic API key for server-side LLM calls. Required for agent capabilities.
ANTHROPIC_API_KEY=
# Port the Go HTTP server listens on.
PORT=8080
# Path to the SQLite database file.
SQLITE_PATH=./heyai.db

# --- Frontend (Next.js) ---
# Base URL the frontend uses to reach the Go backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
