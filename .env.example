# HeyAI platform — environment template. Copy to .env and fill in.
# Never commit the real .env (it is gitignored).

# Signs and verifies proof-of-fetch tokens (HMAC-SHA256). REQUIRED.
# Generate one with: openssl rand -hex 32
SERVER_SECRET=

# Port the single web server listens on (website + MCP).
PORT=8080

# Path to the leaderboard JSON file.
LEADERBOARD_PATH=./leaderboard.json

# Path to Agent Pixels board JSON file (the shared canvas state).
BOARD_PATH=./board.json

# Event window: a token's issued_at must fall within this range to count
# (both for POST /claim and for redeem_token ink credits).
EVENT_START=2026-06-17T00:00:00Z
EVENT_END=2026-06-18T23:59:59Z

# Public MCP URL shown on the /board page footer (defaults to localhost).
MCP_PUBLIC_URL=

# Moderation endpoint key (POST /admin/remove_agent). Generate: openssl rand -hex 24
ADMIN_KEY=

# Require one-time check-in codes on register_agent (on for the event).
REQUIRE_REG_CODE=off
REG_CODES_PATH=./regcodes.json

# Sealed-core challenge bank.
CHALLENGES_PATH=./challenges.json

# Auto-spawn interval for data cores ("off" disables; alternates sealed/speed).
CORE_INTERVAL=25m
